generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Scene {
  id         Int         @id @default(autoincrement())
  name       String
  imageUrl   String
  characters Character[]
  games      Game[]
}

// Hit box: fractions (0–1) of the Scene's width and height, x1 < x2 and y1 < y2.
model Character {
  id           Int              @id @default(autoincrement())
  name         String
  imageUrl     String
  scene        Scene            @relation(fields: [sceneId], references: [id])
  sceneId      Int
  x1           Float
  y1           Float
  x2           Float
  y2           Float
  foundInGames FoundCharacter[]
}

// A Game with a playerName is a Score.
model Game {
  id              String           @id @default(uuid())
  scene           Scene            @relation(fields: [sceneId], references: [id])
  sceneId         Int
  startedAt       DateTime
  finishedAt      DateTime?
  playerName      String?
  foundCharacters FoundCharacter[]
}

model FoundCharacter {
  game        Game      @relation(fields: [gameId], references: [id])
  gameId      String
  character   Character @relation(fields: [characterId], references: [id])
  characterId Int

  @@id([gameId, characterId])
}
